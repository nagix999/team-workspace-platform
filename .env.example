# Explicit local-development values only. Production uses HTTPS, reviewed image
# digests, managed secrets, XFS project quota, and host health manifests.
COMPOSE_PROJECT_NAME=team-platform-local
PLATFORM_ADMIN_USERNAME=platform-admin
NATIVE_ENABLE_SIGNUP=true
PLATFORM_WORKSPACE_CPU_BUDGET_MILLICORES=8000
PLATFORM_WORKSPACE_MEMORY_BUDGET_MB=4096

# Run `bash scripts/init-local.sh` to copy this file and set the host socket GID.
DOCKER_GID=REPLACE_WITH_DOCKER_SOCKET_GID
PLATFORM_SECRET_GID=REPLACE_WITH_LOCAL_SECRET_GROUP_GID
