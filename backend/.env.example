# Generate independent values; never use the examples in a real deployment.
PLATFORM_DATABASE_URL=sqlite:////var/lib/platform/platform.db
PLATFORM_PORTAL_ORIGIN=https://platform.example.com
JUPYTERHUB_INTERNAL_URL=http://jupyterhub:8081
JUPYTERHUB_PUBLIC_URL=https://hub.example.net
JUPYTERHUB_USER_DOMAIN=hub.example.net
JUPYTERHUB_OAUTH_CLIENT_ID=service-platform-api
JUPYTERHUB_OAUTH_CLIENT_SECRET=replace-me
# Or set JUPYTERHUB_OAUTH_CLIENT_SECRET_FILE=/run/secrets/platform_oauth_client_secret
JUPYTERHUB_OAUTH_REDIRECT_URI=https://platform.example.com/api/v1/auth/callback
PLATFORM_TOKEN_ENCRYPTION_KEY=replace-with-python-secrets-token-urlsafe-compatible-32-byte-base64
# Or PLATFORM_TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/platform_token_encryption_key
PLATFORM_TOKEN_ENCRYPTION_KEY_ID=v1
PLATFORM_SESSION_HASH_KEY=replace-with-at-least-32-random-bytes
# Or PLATFORM_SESSION_HASH_KEY_FILE=/run/secrets/platform_session_hash_key
PLATFORM_INTERNAL_HMAC_KEY=replace-with-an-independent-random-key
# Or PLATFORM_INTERNAL_HMAC_KEY_FILE=/run/secrets/platform_spawn_hmac_key
PLATFORM_ADMIN_USERNAMES=platform-admin
PLATFORM_COOKIE_SECURE=true
PLATFORM_ENFORCE_SAFE_SQLITE=true
PLATFORM_EXECUTION_HOST_HEALTHY=false
PLATFORM_WORKSPACE_CPU_BUDGET_MILLICORES=8000
PLATFORM_WORKSPACE_MEMORY_BUDGET_MB=4096
PLATFORM_WORKSPACE_DELETION_ENABLED=false
PLATFORM_LIFECYCLE_TIMEOUT_SECONDS=900
PLATFORM_RECONCILIATION_FRESHNESS_SECONDS=30
# Worker-only. Never mount this service credential into the API container.
JUPYTERHUB_ADMIN_LIFECYCLE_TOKEN_FILE=/run/secrets/jupyterhub_admin_lifecycle_token
# Local HTTP only: PLATFORM_INSECURE_LOCAL_DEV=true and PLATFORM_COOKIE_SECURE=false
